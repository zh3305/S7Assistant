<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             x:Class="S7Assistant.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <styling:FluentAvaloniaTheme PreferUserAccentColor="True" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://S7Assistant/Styles/CustomStyles.axaml" />
        <StyleInclude Source="avares://S7Assistant/Styles/LightIndustrial.axaml" />
        
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Roboto"/>
        </Style>
    </Application.Styles>
</Application>
