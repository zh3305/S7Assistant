<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:S7Assistant.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="using:S7Assistant.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="S7Assistant.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="S7小助手 V2.0 - 高性能PLC监控"
        MinWidth="1000" MinHeight="700"
        Width="1200" Height="800"
        Background="{StaticResource MainBg}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:BoolToConnectionStatusConverter x:Key="BoolToConnectionStatusConverter"/>
        <converters:PlcStatusConverter x:Key="PlcStatusConverter"/>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto, Auto, *, 150, Auto">
        <!-- 顶部超紧凑标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" Padding="16,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="S7 Assistant" FontWeight="Black" FontSize="14" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentPrimary}" CornerRadius="2" Padding="4,1" VerticalAlignment="Center">
                        <TextBlock Text="V2.0 PRO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ProviderType}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 紧凑配置面板 -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal">
                <!-- 通信设置组 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,24,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="PLC IP地址" Classes="label"/>
                        <TextBox Text="{Binding ConnectionConfig.Ip}" Width="110"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="CPU类型" Classes="label"/>
                        <ComboBox ItemsSource="{Binding CpuTypes}" SelectedItem="{Binding ConnectionConfig.CpuType}" Width="100"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="机架" Classes="label"/>
                        <NumericUpDown Value="{Binding ConnectionConfig.Rack}" Minimum="0" Maximum="7" Width="65"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="插槽" Classes="label"/>
                        <NumericUpDown Value="{Binding ConnectionConfig.Slot}" Minimum="0" Maximum="31" Width="65"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                        <Button Classes="primary" Command="{Binding ConnectCommand}" Content="连接" IsVisible="{Binding !IsConnected}" Width="60"/>
                        <Button Classes="outline" Command="{Binding DisconnectCommand}" Content="断开" IsVisible="{Binding IsConnected}" Width="60" Foreground="{StaticResource AccentDanger}" BorderBrush="{StaticResource AccentDanger}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 配置文件组 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,24,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="当前配置文件" Classes="label"/>
                        <ComboBox ItemsSource="{Binding ConfigFiles}" SelectedItem="{Binding SelectedConfigFile}" Width="130"/>
                    </StackPanel>
                    <Button Classes="outline" Command="{Binding OpenConfigManagerCommand}" Content="配置管理" VerticalAlignment="Bottom" IsEnabled="{Binding !IsConnected}"/>
                </StackPanel>

                <!-- 运行控制组 -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="刷新间隔" Classes="label"/>
                        <ComboBox SelectedIndex="{Binding MonitorIntervalIndex}" Width="85">
                            <ComboBoxItem Content="50ms"/>
                            <ComboBoxItem Content="100ms"/>
                            <ComboBoxItem Content="200ms"/>
                            <ComboBoxItem Content="500ms"/>
                            <ComboBoxItem Content="1s"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                        <Button Classes="outline" Command="{Binding StartMonitoringCommand}" Content="开始监视" IsEnabled="{Binding CanStartMonitoring}"/>
                        <Button Classes="outline" Command="{Binding StopMonitoringCommand}" Content="停止监视" IsEnabled="{Binding IsMonitoring}"/>
                        <Button Classes="outline" Command="{Binding ReadAllCommand}" Content="单次读取" IsEnabled="{Binding IsConnected}"/>
                        <Button Classes="outline" Command="{Binding RefreshStatusCommand}" Content="PLC状态" IsEnabled="{Binding IsConnected}"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 高密度数据网格 -->
        <Border Grid.Row="2" Background="White">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="#f8fafc" Padding="16,6" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="实时变量列表" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AllDataItems.Count, StringFormat='({0}项)'}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="通信周期:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LastCommunicationTime}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentSuccess}" VerticalAlignment="Center"/>
                                <TextBlock Text="ms" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding AllDataItems}" SelectedItem="{Binding SelectedItem}"
                          IsReadOnly="False" AutoGenerateColumns="False" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#f1f5f9" VerticalGridLinesBrush="#f1f5f9"
                          x:CompileBindings="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="逻辑地址" Binding="{Binding FullAddress, Mode=OneWay}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="1.8*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="数据类型" Binding="{Binding Type}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="实时数值" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="4,0" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Value, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="16进制" Binding="{Binding HexValue, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="数值写入" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="2">
                                        <TextBox Text="{Binding WriteValue}" Watermark="输入..." Height="22" FontSize="10" Padding="4,1" MinHeight="22"/>
                                        <Button Grid.Column="1" Content="SET" Classes="action-small" Command="{Binding $parent[Window].DataContext.WriteValueCommand}" CommandParameter="{Binding}" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="注释说明" Binding="{Binding Remark}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 紧凑日志列表 -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="#f1f5f9" Padding="12,4" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="系统诊断日志" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentDanger}" CornerRadius="2" Padding="4,0" VerticalAlignment="Center" IsVisible="{Binding ErrorCount}">
                                <TextBlock Text="{Binding ErrorCount, StringFormat='{}错误: {0}'}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding ClearLogsCommand}" Content="清空" Padding="8,1" FontSize="9" Classes="outline" Height="20" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="10,5">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="10" Margin="0,1" TextWrapping="Wrap">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource LogLevelToColorConverter}">
                                            <Binding/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 极简状态栏 -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBg}" Padding="12,4" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="扫描状态:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding IsMonitoring, Converter={StaticResource PlcStatusConverter}}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Width="1" Height="10" Background="{StaticResource BorderColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="S7 PROTOCOL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>